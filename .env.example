# Veterans Employment Pathways Agent — Environment Variables
# Copy this file to .env and fill in your keys

# Required: Groq API key (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: run the agent on a local Ollama model instead of Groq.
# Keeps prompts and RSA-911 tool outputs on this machine. Pull the model first:
#   ollama pull gpt-oss:20b
# Local mode also turns off AgentOps and runs the judge and RAGAS on Ollama.
# AGNO_MODEL_PROVIDER=ollama
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_JUDGE_MODEL=qwen2.5:7b-instruct
# OLLAMA_NUM_CTX=16384

# Required: AgentOps API key (free at agentops.ai)
AGENTOPS_API_KEY=your_agentops_api_key_here

# Optional: O*NET API key (free registration at onetonline.org/developer/)
# If not set, falls back to DuckDuckGo search on onetonline.org
ONET_API_KEY=your_onet_api_key_here

# Optional: PubMed settings for evaluation
# Set to true to force PubMed retrieval during evaluation runs
EVAL_FORCE_PUBMED=false
PUBMED_EMAIL=your_email_here

# Login for the web app (required; the public Cloudflare URL is open to anyone)
APP_USERNAME=your_username_here
APP_PASSWORD=your_password_here

# Differential privacy for the agent's custom RSA-911 SQL queries (see rsa911/README.md)
RSA911_DP=on
RSA911_DP_EPSILON=1.0
RSA911_DP_DELTA=1e-6
RSA911_DP_BUDGET=50

# Stop library usage statistics from being sent to Agno and Chroma
AGNO_TELEMETRY=false
ANONYMIZED_TELEMETRY=False
